{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($code).child('phase').val() === 'lobby' && !data.exists()",
            ".validate": "newData.hasChildren(['name','seat']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('seat').isNumber() && newData.child('seat').val() >= 0 && newData.child('seat').val() <= 100"
          }
        },
        "rounds": {
          "$round": {
            "bids": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($code).child('phase').val() === 'bidding' && root.child('games').child($code).child('players').child(auth.uid).exists()",
                ".validate": "newData.hasChildren(['value','blind']) && newData.child('value').isNumber() && newData.child('value').val() >= 0 && newData.child('value').val() <= 8 && newData.child('blind').isBoolean()"
              }
            },
            "tricks": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('games').child($code).child('phase').val() === 'tricks' && root.child('games').child($code).child('players').child(auth.uid).exists()",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
              }
            }
          }
        },
        "reconnectRequests": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('games').child($code).child('phase').val() !== 'lobby' && !root.child('games').child($code).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['playerId','requestedAt']) && newData.child('playerId').isString() && root.child('games').child($code).child('players').child(newData.child('playerId').val()).exists() && newData.child('requestedAt').isNumber()"
          }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['name','createdAt']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 24 && newData.child('createdAt').isNumber()"
      }
    }
  }
}
